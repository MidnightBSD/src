.Nd per-CPU capability layer for heterogeneous processors
.Sh SYNOPSIS
.Cd "options SCHED_MIC"
.Pp
.In sys/smp.h
.In sys/cpucap.h
.Ft int
.Fn cpucap_provider_register "struct cpucap_provider *cp"
.Ft void
.Fn cpucap_provider_unregister "struct cpucap_provider *cp"
.Fn CPUCAP_PROVIDER_DECLARE "sym" "struct cpucap_provider provider"
.Ft void
.Fn cpucap_set_class "int cpu" "uint8_t cls"
.Ft void
.Fn cpucap_set_capacity "int cpu" "uint16_t capacity"
.Ft void
.Fn cpucap_set_scores "int cpu" "uint8_t perf" "uint8_t eff"
.Ft void
.Fn cpucap_set_compute_class "uint8_t cls" "bool prefer_compute"
.Ft void
.Fn cpucap_commit "void"
.Ft void
.Fn cpucap_consumer_register "struct cpucap_consumer *cc"
.Ft void
.Fn cpucap_consumer_unregister "struct cpucap_consumer *cc"
.Ft uint8_t
