#! /usr/libexec/atf-sh

atf_test_case creates_package
creates_package_head()
{
	atf_set "descr" "mport.create creates a package from a staged file and plist"
}
creates_package_body()
{
	setup_tree

	atf_check \
		-s exit:0 \
		-o empty \
		-e empty \
		"${MPORT_CREATE}" \
		-n testpkg \
		-v 1.0 \
		-o "${PWD}/testpkg-1.0.mport" \
		-s "${PWD}/root" \
		-p "${PWD}/plist" \
		-P /usr/local \
		-O misc/testpkg \
		-t misc \
		-c "test package"

	atf_check -s exit:0 test -s "${PWD}/testpkg-1.0.mport"
}

atf_test_case records_abi_file_release
records_abi_file_release_head()
{
	atf_set "descr" "mport.create records the release in ABI_FILE's ABI note"
	atf_set "require.files" "/bin/sh"
	atf_set "require.progs" "readelf sqlite3"
}
records_abi_file_release_body()
{
	setup_tree

	tag=$(readelf -n /bin/sh | awk '/ABI tag:/ { print $3; exit }')
	[ -n "${tag}" ] || atf_skip "/bin/sh carries no ABI tag"
	release="$((tag / 100000)).$((tag / 1000 % 100))"

	atf_check \
		-s exit:0 \
		-o empty \
		-e empty \
		env ABI_FILE=/bin/sh "${MPORT_CREATE}" \
		-n testpkg \
		-v 1.0 \
		-o "${PWD}/testpkg-1.0.mport" \
		-s "${PWD}/root" \
		-p "${PWD}/plist" \
		-P /usr/local \
		-O misc/testpkg \
		-t misc \
		-c "test package"

	atf_check -s exit:0 tar -xf "${PWD}/testpkg-1.0.mport" +CONTENTS.db
	atf_check -s exit:0 -o inline:"${release}\n" \
		sqlite3 +CONTENTS.db "SELECT os_release FROM packages"
	atf_check -s exit:0 -o inline:"${tag}\n" \
		sqlite3 +CONTENTS.db "SELECT value FROM meta WHERE field='MidnightBSD_version'"
}

atf_test_case rejects_unreadable_abi_file
rejects_unreadable_abi_file_head()
{
	atf_set "descr" "mport.create fails rather than record the host ABI for a bad ABI_FILE"
}
rejects_unreadable_abi_file_body()
{
	setup_tree

	atf_check \
		-s not-exit:0 \
		-o ignore \
		-e match:"ABI_FILE" \
		env ABI_FILE="${PWD}/missing" "${MPORT_CREATE}" \
		-n testpkg \
		-v 1.0 \
		-o "${PWD}/testpkg-1.0.mport" \
		-s "${PWD}/root" \
		-p "${PWD}/plist" \
		-P /usr/local \
		-O misc/testpkg \
		-t misc \
		-c "test package"

	atf_check -s not-exit:0 test -e "${PWD}/testpkg-1.0.mport"
}

