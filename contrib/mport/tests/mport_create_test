atf_test_case drops_duplicate_plist_entries
drops_duplicate_plist_entries_head()
{
	atf_set "descr" "mport.create warns about and drops a file listed twice in the plist"
	atf_set "require.progs" "sqlite3"
}
drops_duplicate_plist_entries_body()
{
	setup_tree
	# the same file again, as USE_RC_SUBR adds an rc.d script a port also lists
	printf "@(root,wheel,0444) share/testpkg/file.txt\n" >>plist
	printf "/usr/local/share/testpkg/file.txt\n" >>plist

	atf_check \
		-s exit:0 \
		-o match:"duplicate plist entry for /usr/local/share/testpkg/file.txt removed" \
		-e empty \
		"${MPORT_CREATE}" \
		-n testpkg \
		-v 1.0 \
		-o "${PWD}/testpkg-1.0.mport" \
		-s "${PWD}/root" \
		-p "${PWD}/plist" \
		-P /usr/local \
		-O misc/testpkg \
		-t misc \
		-c "test package"

	atf_check -s exit:0 tar -xf "${PWD}/testpkg-1.0.mport" +CONTENTS.db
	atf_check -s exit:0 -o inline:"1|share/testpkg/file.txt\n" \
		sqlite3 +CONTENTS.db "SELECT type, data FROM assets WHERE data LIKE '%file.txt'"
}

atf_test_case reports_bundle_write_failure
reports_bundle_write_failure_head()
{
	atf_set "descr" "mport.create fails when the bundle cannot be finished (full disk)"
}
reports_bundle_write_failure_body()
{
	[ -c /dev/full ] || atf_skip "/dev/full is not available"

	setup_tree

	atf_check \
		-s not-exit:0 \
		-o empty \
		-e match:"Couldn't finish writing /dev/full" \
		"${MPORT_CREATE}" \
		-n testpkg \
		-v 1.0 \
		-o /dev/full \
		-s "${PWD}/root" \
		-p "${PWD}/plist" \
		-P /usr/local \
		-O misc/testpkg \
		-t misc \
		-c "test package"
}

atf_test_case mport_version_runs
mport_version_runs_head()
{
	atf_set "descr" "mport frontend can print its version"
}
mport_version_runs_body()
{
	atf_check \
		-s exit:0 \
		-o empty \
		-e match:"^[0-9]+\\.[0-9]+\\.[0-9]+" \
		"${MPORT}" -v
}

setup_tree()
{
	mkdir -p root/usr/local/share/testpkg
	printf "hello\n" >root/usr/local/share/testpkg/file.txt
	printf "share/testpkg/file.txt\n" >plist
}

atf_init_test_cases()
{
	srcdir=$(atf_get_srcdir)
	: "${MPORT_CREATE:=${srcdir}/../libexec/mport.create/mport.create}"
	: "${MPORT:=${srcdir}/../mport/mport}"
	: "${LD_LIBRARY_PATH:=${srcdir}/../libmport}"
	export MPORT_CREATE MPORT LD_LIBRARY_PATH

	atf_add_test_case creates_package
	atf_add_test_case rejects_invalid_expiration_date
	atf_add_test_case rejects_long_output_path
	atf_add_test_case rejects_bad_tmpdir
	atf_add_test_case mport_version_runs
	atf_add_test_case records_abi_file_release
	atf_add_test_case rejects_unreadable_abi_file
	atf_add_test_case drops_duplicate_plist_entries
	atf_add_test_case reports_bundle_write_failure
}
