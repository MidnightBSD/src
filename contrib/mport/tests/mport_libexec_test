{
	setup_merge_tree
	printf 'share/pkga/f\n' >plist.pkga
	make_differing_copy pkga
	printf 'previous bundle\n' >croot/out.mport

	atf_check -s not-exit:0 -o empty -e match:"Package pkga is in both" \
		env TMPDIR=/tmp "${MPORT_MERGE}" -c "${PWD}/croot" -o /out.mport \
		/pkga.mport /again.mport
	atf_check -s exit:0 -o inline:"previous bundle\n" cat croot/out.mport
	atf_check -s exit:0 -o inline:"out.mport\n" sh -c "ls croot | grep '^out\.mport'"
}

