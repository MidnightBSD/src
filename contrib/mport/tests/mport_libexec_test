atf_test_case check_fake_accepts_symlinks_resolved_at_install
check_fake_accepts_symlinks_resolved_at_install_head()
{
	atf_set "descr" "mport.check-fake accepts symlinks whose targets exist once installed"
}
check_fake_accepts_symlinks_resolved_at_install_body()
{
	setup_fake_tree
	mkdir -p root/usr/local/share/testpkg/rules root/var/lib/xkb
	printf "base\n" >root/usr/local/share/testpkg/rules/base
	# relative link to a sibling staged file (meson -Dxorg-rules-symlinks style)
	ln -s base root/usr/local/share/testpkg/rules/xorg
	# absolute link to a file this package stages
	ln -s /usr/local/share/testpkg/rules/base root/usr/local/share/testpkg/absinside
	# absolute link to a directory this package declares with @dir (issue #106)
	ln -s /var/lib/xkb root/usr/local/share/testpkg/compiled
	# relative link that climbs out of the stage tree to a base-system path
	ln -s ../../../../etc root/usr/local/share/testpkg/escape
	printf "share/testpkg/rules/base\nshare/testpkg/rules/xorg\n" >>plist
	printf "share/testpkg/absinside\nshare/testpkg/compiled\nshare/testpkg/escape\n" >>plist
	printf "@dir /var/lib/xkb\n" >>plist

	atf_check -s exit:0 \
		-o match:"Fake succeeded" \
		-o not-match:"WARN" \
		-e empty \
		"${MPORT_CHECK_FAKE}" \
		-f "${PWD}/plist" \
		-d "${PWD}/root" \
		-p /usr/local
}

