	atf_check -s exit:0 -o inline:"pkga\npkgb\n" \
		sqlite3 croot/+CONTENTS.db "SELECT pkg FROM packages ORDER BY pkg;"
}

# make_differing_copy name: build croot/again.mport, a copy of package
# <name> whose bundle differs from croot/<name>.mport
make_differing_copy()
{
	make_merge_pkg "$1" "" -D "pkgz:misc/pkgz:>=1.0"
	mv "croot/$1.mport" croot/again.mport
	make_merge_pkg "$1" ""
}

