	atf_set "descr" "mport.merge keeps one copy of a bundle given twice or byte-identical"
	atf_set "require.user" "root"
}
merge_skips_identical_bundle_body()
{
	setup_merge_tree
	make_merge_pkg pkga share/pkga/f
	make_merge_pkg pkgb share/pkgb/f
	cp croot/pkga.mport croot/again.mport

	atf_check -s exit:0 -o empty -e empty \
		env TMPDIR=/tmp "${MPORT_MERGE}" -c "${PWD}/croot" -o /out.mport \
