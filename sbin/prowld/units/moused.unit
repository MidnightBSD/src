# moused.unit - native prowld(8) unit for moused(8)
#
# Replaces the rc.d/moused shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with moused_enable in
# rc.conf; moused_flags is honoured as in rc.d/moused.
#
# moused runs in the foreground (-f) so that prowld supervises it directly.
# Only the default mouse (moused_port) is handled; per-device instances such
# as "service moused start psm0" still go through the rc.d script.

label = "org.midnightbsd.moused";
description = "Mouse daemon";
type = "daemon";
rc_name = "moused";
run_at_load = true;
keep_alive = true;
nojail = true;
provides = ["moused"];
wants = ["DAEMON", "FILESYSTEMS"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config moused\nmousechar_arg=\ncase \"$mousechar_start\" in\n[Nn][Oo] | '')\n    ;;\n*)\n    mousechar_arg=\"-M $mousechar_start\"\n    ;;\nesac\nfor ttyv in /dev/ttyv*; do\n    [ \"$ttyv\" = '/dev/ttyv*' ] && break\n    vidcontrol < $ttyv $mousechar_arg -m on\ndone\nexec /usr/sbin/moused -f $moused_flags -p $moused_port", "moused"];
