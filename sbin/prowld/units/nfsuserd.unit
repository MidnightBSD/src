# nfsuserd.unit - native prowld(8) unit for nfsuserd(8)
#
# Replaces the rc.d/nfsuserd shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with nfsuserd_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/nfsuserd.
#
# nfsuserd always detaches from its parent and has no foreground mode.  The
# wrapper therefore waits for the daemon and stops it when prowld sends
# SIGTERM, so prowld still sees the service end and can restart it.  The master process
# is stopped with SIGUSR1, as rc.d/nfsuserd does.

label = "org.midnightbsd.nfsuserd";
description = "NFSv4 user and group name mapping daemon";
type = "daemon";
rc_name = "nfsuserd";
run_at_load = true;
keep_alive = true;
provides = ["nfsuserd"];
wants = ["NETWORKING"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config nfsuserd\nif checkyesno nfs_server_managegids; then\n    nfsuserd_flags=\"-manage-gids $nfsuserd_flags\"\nfi\n/usr/sbin/nfsuserd $nfsuserd_flags || exit 1\ni=0\npid=\nwhile [ -z \"$pid\" ] && [ $i -lt 10 ]; do\n    pid=$(pgrep -o -x nfsuserd)\n    [ -n \"$pid\" ] || sleep 1\n    i=$((i + 1))\ndone\n[ -n \"$pid\" ] || exit 1\nstopping=\ntrap 'stopping=1; kill -USR1 $pid 2> /dev/null' TERM INT\nwhile kill -0 $pid 2> /dev/null; do\n    sleep 1 &\n    wait $!\ndone\n[ -z \"$stopping\" ] || exit 0\nexit 1", "nfsuserd"];
