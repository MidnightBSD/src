# iscsid.unit - native prowld(8) unit for iscsid(8)
#
# Replaces the rc.d/iscsid shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with iscsid_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/iscsid.
#
# iscsid stays in the foreground only in debug mode (-d), so its log output,
# which goes to stderr, is discarded and it logs nothing.

label = "org.midnightbsd.iscsid";
description = "iSCSI initiator daemon";
type = "daemon";
rc_name = "iscsid";
run_at_load = true;
keep_alive = true;
nojail = true;
provides = ["iscsid"];
wants = ["NETWORK"];
before = ["DAEMON"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config iscsid\nkldstat -q -m iscsi || kldload iscsi || exit 1\nexec /usr/sbin/iscsid -d -P /var/run/iscsid.pid $iscsid_flags > /dev/null 2>&1", "iscsid"];
