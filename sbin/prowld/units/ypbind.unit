# ypbind.unit - native prowld(8) unit for ypbind(8)
#
# Replaces the rc.d/ypbind shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with ypbind_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/ypbind.
#
# ypbind always detaches.  The wrapper finds it with pgrep and waits for it.
# It is enabled by nis_client_enable.

label = "org.midnightbsd.ypbind";
description = "NIS domain binding daemon";
type = "daemon";
rc_name = "ypbind";
run_at_load = true;
keep_alive = true;
rc_name = "nis_client";
provides = ["ypbind"];
wants = ["ypserv", "nisdomain"];
before = ["DAEMON"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config ypbind\n/etc/rc.d/rpcbind status > /dev/null 2>&1 || /etc/rc.d/rpcbind onestart || exit 1\n[ -n \"$(domainname)\" ] || { echo \"NIS domainname(1) is not set.\" >&2; exit 1; }\n/usr/sbin/ypbind $nis_client_flags || exit 1\ni=0\npid=\nwhile [ -z \"$pid\" ] && [ $i -lt 10 ]; do\n    pid=$(pgrep -o -x ypbind)\n    [ -n \"$pid\" ] || sleep 1\n    i=$((i + 1))\ndone\n[ -n \"$pid\" ] || exit 1\nstopping=\ntrap 'stopping=1; kill -TERM $pid 2> /dev/null' TERM INT\nwhile kill -0 $pid 2> /dev/null; do\n    sleep 1 &\n    wait $!\ndone\n[ -z \"$stopping\" ] || exit 0\nexit 1", "ypbind"];
