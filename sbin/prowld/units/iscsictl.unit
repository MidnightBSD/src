# iscsictl.unit - native prowld(8) unit for iscsictl(8)
#
# Replaces the rc.d/iscsictl shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with iscsictl_enable in
# rc.conf.
# iscsictl_flags defaults to "-Aa" (log in to all configured targets).


label = "org.midnightbsd.iscsictl";
description = "Start the iSCSI initiator sessions";
type = "oneshot";
rc_name = "iscsictl";
run_at_load = true;
nojail = true;
provides = ["iscsictl"];
wants = ["NETWORK", "iscsid"];
before = ["DAEMON"];
required_modules = ["iscsi"];
program = "/usr/bin/iscsictl";
arguments = ["@iscsictl_flags@"];
