# dhcp6c.unit - native prowld(8) unit for dhcp6c(8)
#
# Replaces the rc.d/dhcp6c shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with dhcp6c_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/dhcp6c.
#
# dhcp6c runs in the foreground (-f).  The configuration file and the
# interface list (dhcp6c_interfaces) are checked as in rc.d/dhcp6c.

label = "org.midnightbsd.dhcp6c";
description = "DHCPv6 client";
type = "daemon";
rc_name = "dhcp6c";
run_at_load = true;
keep_alive = true;
required_files = ["/etc/dhcp6c.conf"];
nojail = true;
provides = ["dhcp6c"];
wants = ["DAEMON"];
before = ["firstboot"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config dhcp6c\nconfig=$dhcp6c_config\n[ -n \"$config\" ] || config=/etc/dhcp6c.conf\n[ -r \"$config\" ] || exit 1\n[ -n \"$dhcp6c_interfaces\" ] || { echo \"dhcp6c_interfaces is not set.\" >&2; exit 1; }\nexec /sbin/dhcp6c -f -c $config -p /var/run/dhcp6c.pid $dhcp6c_flags $dhcp6c_interfaces", "dhcp6c"];
