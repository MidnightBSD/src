# rwhod.unit - native prowld(8) unit for rwhod(8)
#
# Replaces the rc.d/rwhod shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with rwhod_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/rwhod.
#
# rwhod always detaches.  The wrapper finds it with pgrep and waits for it.

label = "org.midnightbsd.rwhod";
description = "System status server";
type = "daemon";
rc_name = "rwhod";
run_at_load = true;
keep_alive = true;
provides = ["rwho", "rwhod"];
wants = ["DAEMON"];
before = ["LOGIN"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config rwhod\n/usr/sbin/rwhod $rwhod_flags || exit 1\ni=0\npid=\nwhile [ -z \"$pid\" ] && [ $i -lt 10 ]; do\n    pid=$(pgrep -o -x rwhod)\n    [ -n \"$pid\" ] || sleep 1\n    i=$((i + 1))\ndone\n[ -n \"$pid\" ] || exit 1\nstopping=\ntrap 'stopping=1; kill -TERM $pid 2> /dev/null' TERM INT\nwhile kill -0 $pid 2> /dev/null; do\n    sleep 1 &\n    wait $!\ndone\n[ -z \"$stopping\" ] || exit 0\nexit 1", "rwhod"];
