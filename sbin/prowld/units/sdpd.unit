# sdpd.unit - native prowld(8) unit for sdpd(8)
#
# Replaces the rc.d/sdpd shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with sdpd_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/sdpd.
#
# sdpd runs in the foreground (-d).

label = "org.midnightbsd.sdpd";
description = "Bluetooth Service Discovery Protocol daemon";
type = "daemon";
rc_name = "sdpd";
run_at_load = true;
keep_alive = true;
nojail = true;
provides = ["sdpd"];
wants = ["DAEMON"];
before = ["LOGIN"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config sdpd\nkldstat -q -m ng_btsocket || kldload ng_btsocket || exit 1\n[ -n \"$sdpd_control\" ] || sdpd_control=/var/run/sdp\n[ -n \"$sdpd_groupname\" ] || sdpd_groupname=nobody\n[ -n \"$sdpd_username\" ] || sdpd_username=nobody\nexec /usr/sbin/sdpd -d -c $sdpd_control -g $sdpd_groupname -u $sdpd_username $sdpd_flags", "sdpd"];
