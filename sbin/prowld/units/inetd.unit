# inetd.unit - native prowld(8) unit for inetd(8)
#
# Replaces the rc.d/inetd shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with inetd_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/inetd.
#
# inetd only keeps its pidfile, which "service inetd reload" needs, when it
# detaches from its parent; in the foreground (-d) it also logs a great deal.
# The wrapper therefore lets inetd detach, waits for the daemon in the pidfile
# and stops it when prowld sends SIGTERM, so prowld still sees the service end
# and can restart it.  SIGHUP, which makes inetd reread its configuration, is
# passed on to the daemon.

label = "org.midnightbsd.inetd";
description = "Internet super-server";
type = "daemon";
rc_name = "inetd";
run_at_load = true;
keep_alive = true;
provides = ["inetd"];
wants = ["DAEMON", "LOGIN", "FILESYSTEMS"];
required_files = ["/etc/inetd.conf"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config inetd\npidfile=/var/run/inetd.pid\nrm -f $pidfile\n/usr/sbin/inetd $inetd_flags || exit 1\ni=0\nwhile [ ! -s $pidfile ] && [ $i -lt 10 ]; do\n    sleep 1\n    i=$((i + 1))\ndone\npid=$(cat $pidfile) || exit 1\ntrap 'kill $pid 2> /dev/null; exit 0' TERM INT\ntrap 'kill -HUP $pid 2> /dev/null' HUP\nwhile kill -0 $pid 2> /dev/null; do\n    sleep 1 &\n    wait $!\ndone\nexit 1", "inetd"];
