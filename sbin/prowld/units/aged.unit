# aged.unit - native prowld(8) unit for aged(8)
#
# Replaces the rc.d/aged shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with aged_enable in
# rc.conf.
#
# aged runs in the foreground (-F) so that prowld supervises it directly.
# It creates and takes ownership of its own state directories.

label = "org.midnightbsd.aged";
description = "Age verification daemon";
type = "daemon";
rc_name = "aged";
run_at_load = true;
keep_alive = true;
provides = ["aged"];
wants = ["DAEMON"];
before = ["LOGIN"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config aged\nexec /usr/sbin/aged -F $aged_flags", "aged"];
