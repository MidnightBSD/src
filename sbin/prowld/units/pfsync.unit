# pfsync.unit - native prowld(8) unit for pfsync(8)
#
# Replaces the rc.d/pfsync shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with pfsync_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/pfsync.
#
# A oneshot: it configures pfsync0 and exits.  "prowlctl stop pfsync" takes
# the interface down again.  pfsync_syncdev must be set; the unit fails
# without it (the first start_pre command is false(1), run only when
# pfsync_syncdev is empty).

label = "org.midnightbsd.pfsync";
description = "Packet filter state table synchronisation interface";
type = "oneshot";
rc_name = "pfsync";
run_at_load = true;
provides = ["pfsync"];
wants = ["FILESYSTEMS", "netif"];
required_modules = ["pf", "pfsync"];
start_pre = [["~pfsync_syncdev", "/usr/bin/false"]];
program = "/sbin/ifconfig";
arguments = ["pfsync0", "@pfsync_syncpeer:+syncpeer@", "@pfsync_syncpeer@", "syncdev", "@pfsync_syncdev@", "@pfsync_ifconfig@", "up"];
stop_arguments = ["pfsync0", "-syncdev", "-syncpeer", "down"];
