# blacklistd.unit - native prowld(8) unit for blacklistd(8)
#
# Replaces the rc.d/blacklistd shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with blacklistd_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/blacklistd.
#
# blacklistd was renamed to blocklistd; the unit is kept for old setups and
# warns, like the rc.d script.  blacklistd runs in the foreground (-f).

label = "org.midnightbsd.blacklistd";
description = "The blacklist daemon, renamed to blocklistd";
type = "daemon";
rc_name = "blacklistd";
run_at_load = true;
keep_alive = true;
provides = ["blacklistd"];
wants = ["netif", "ipfilter", "ipfw", "pf"];
conflicts = ["blocklistd"];
required_files = ["/etc/blacklistd.conf"];
program = "/bin/sh";
arguments = ["-c", ". /etc/rc.subr\nload_rc_config blacklistd\necho \"WARNING: blacklistd has been renamed to blocklistd\"\nexec /usr/sbin/blacklistd -f $blacklistd_flags", "blacklistd"];
