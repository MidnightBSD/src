# statd.unit - native prowld(8) unit for rpc.statd(8)
#
# Replaces the rc.d/statd shim: a shim whose PROVIDE is already covered by
# a native unit is skipped.  Enable and disable it with rpc_statd_enable in
# rc.conf; the other rc.conf variables are honoured as in rc.d/statd.
#
# rpc.statd runs in the foreground (-F).  rpcbind is started if it is not
# running, as rc.d/statd does.

label = "org.midnightbsd.statd";
description = "Host status monitoring daemon";
type = "daemon";
rc_name = "rpc_statd";
run_at_load = true;
keep_alive = true;
nojail = true;
provides = ["statd"];
wants = ["nfsclient"];
before = ["DAEMON"];
activates = ["rpcbind"];
program = "/usr/sbin/rpc.statd";
arguments = ["-F","@rpc_statd_flags@"];
