#!/bin/sh
#
#

# PROVIDE: wpa_supplicant
# REQUIRE: mountcritremote
# KEYWORD: nojail nostart

. /etc/rc.subr
. /etc/network.subr

name="wpa_supplicant"
desc="WPA/802.11i Supplicant for wireless network devices"
rcvar=

ifn="$2"
if [ -z "$ifn" ]; then
	return 1
fi

is_ndis_interface()
{
	case `sysctl -n net.wlan.${1#wlan}.%parent 2>/dev/null` in
		ndis*) true ;;
		*) false ;;
	esac
}

if is_wired_interface ${ifn} ; then
	driver="wired"
elif is_ndis_interface ${ifn} ; then
	driver="ndis"
else
	driver="bsd"
fi

load_rc_config $name

command=${wpa_supplicant_program}
conf_file=${wpa_supplicant_conf_file}
pidfile="/var/run/${name}/${ifn}.pid"
command_args="-B -i $ifn -c $conf_file -D $driver -P $pidfile"
required_files=$conf_file
required_modules="wlan_wep wlan_tkip wlan_ccmp"

# When prowld has a wpa_supplicant@ unit it supervises the client; start and
# stop it through prowlctl(8).  Without prowld the client is run as before.
if [ -x /sbin/prowlctl ] &&
    /sbin/prowlctl show wpa_supplicant@$ifn > /dev/null 2>&1; then
	start_cmd="/sbin/prowlctl start wpa_supplicant@$ifn"
	stop_cmd="/sbin/prowlctl stop wpa_supplicant@$ifn"
	status_cmd="/sbin/prowlctl status wpa_supplicant@$ifn"
fi

run_rc_command "$1"
