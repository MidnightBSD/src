#!/bin/sh
#
#

# PROVIDE: ipfilter
# REQUIRE: FILESYSTEMS
# BEFORE: ipmon ipnat netif netwait securelevel
# KEYWORD: nojailvnet

. /etc/rc.subr

name="ipfilter"
desc="IP packet filter"
rcvar="ipfilter_enable"
load_rc_config $name
start_cmd="ipfilter_locked ipfilter_apply_rules"
stop_cmd="ipfilter_locked ipfilter_stop"
reload_cmd="ipfilter_locked ipfilter_apply_rules"
resync_cmd="ipfilter_resync"
status_cmd="ipfilter_status"
extra_commands="reload resync"
required_modules="ipl:ipfilter"

ipfilter_locked()
{
	local lock

	# Both rc.d and prowld operate on the same inactive kernel rule set.
	lock=/var/run/ipfilter.lock
	# cleanvar removes regular files at boot. Lock a private directory so
	# concurrent callers keep using the same vnode throughout startup.
	mkdir -p -m 700 "${lock}" || return 1
	{
		/usr/bin/lockf -t 0 9 || return 1
		"$@"
	} 9< "${lock}"
}

ipfilter_apply_rules()
{
	local ipf v4 v6 file

	ipf=${ipfilter_program:-/sbin/ipf}
	v4=${ipfilter_rules}
	v6=${ipv6_ipfilter_rules}
	# Either family may be unconfigured. Once selected, its file must load.
	[ -e "${v4}" ] || [ -L "${v4}" ] || v4=
	[ -e "${v6}" ] || [ -L "${v6}" ] || v6=
	if [ -z "${v4}${v6}" ]; then
		warn "no IPFilter rules file found"
		return 1
	fi
	for file in "${v4}" "${v6}"; do
		[ -n "${file}" ] || continue
		if [ ! -f "${file}" ] || [ ! -r "${file}" ]; then
			warn "cannot read IPFilter rules from ${file}"
			return 1
		fi
	done

	if [ "${rc_arg}" = start ]; then
		echo "Enabling ipfilter."
		"${ipf}" -E || return 1
		if [ -n "${ipfilter_optionlist}" ]; then
			"${ipf}" -T "${ipfilter_optionlist}" || return 1
		fi
	else
		echo "Reloading ipfilter rules."
	fi

	# Build the complete replacement before changing the active rule set.
	"${ipf}" -I -Fa || return 1
	if [ -n "${v4}" ]; then
		"${ipf}" -I -f "${v4}" ${ipfilter_flags} || return 1
	fi
	if [ -n "${v6}" ]; then
		"${ipf}" -I -6 -f "${v6}" ${ipfilter_flags} || return 1
	fi
	"${ipf}" -s
}

ipfilter_stop()
{
	local status

	status=$("${ipfilter_program:-/sbin/ipf}" -V) || return 1
	if printf '%s\n' "${status}" | grep -qx 'Running: yes'; then
		echo "Saving firewall state tables"
		"${ipfs_program:-/sbin/ipfs}" -W ${ipfs_flags}
		echo "Disabling ipfilter."
		"${ipfilter_program:-/sbin/ipf}" -D
	fi
}

ipfilter_resync()
{
	"${ipfilter_program:-/sbin/ipf}" -y ${ipfilter_flags}
}

ipfilter_status()
{
	"${ipfilter_program:-/sbin/ipf}" -V
}

run_rc_command "$1"
