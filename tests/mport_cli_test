#! /usr/libexec/atf-sh
#
# Behavioral tests for the mport(8) CLI front end.
#
# The pre-dispatch tests need no package registry and run anywhere.  The
# runtime smoke test exercises the CLI paths that allocate and free package
# vectors (the ones hardened against invalid/leaked frees); it requires a
# local registry and is skipped without one.  Build the tree with
# "make WITH_ASAN=1" to have AddressSanitizer abort on a bad free here.

atf_test_case usage_without_command
usage_without_command_head()
{
	atf_set "descr" "mport with no command prints usage and exits non-zero"
}
usage_without_command_body()
{
	atf_check -s exit:1 -o ignore -e match:"usage: mport" "${MPORT_BIN}"
}

atf_test_case help_flag_prints_usage
help_flag_prints_usage_head()
{
	atf_set "descr" "mport -h prints usage"
}
help_flag_prints_usage_body()
{
	atf_check -s exit:1 -o ignore -e match:"-h          Show help" \
		"${MPORT_BIN}" -h
}

atf_test_case rejects_invalid_global_flag
rejects_invalid_global_flag_head()
{
	atf_set "descr" "mport rejects unknown global options"
}
rejects_invalid_global_flag_body()
{
	atf_check -s not-exit:0 -o ignore -e match:"Invalid argument" \
		"${MPORT_BIN}" -Z
}

atf_test_case reports_bad_chroot
reports_bad_chroot_head()
{
	atf_set "descr" "mport reports chroot failures cleanly"
}
reports_bad_chroot_body()
{
	atf_check -s not-exit:0 -o ignore -e match:"chroot failed" \
		"${MPORT_BIN}" -c "${PWD}/missing-root" search foo
}

atf_test_case global_option_before_subcommand
global_option_before_subcommand_head()
{
	atf_set "descr" "a global option before a subcommand does not eat its arguments"
}
global_option_before_subcommand_body()
{
	# version parses its own -t after the global loop consumed -U; with a
	# stale optind the subcommand saw no arguments and printed usage.
	atf_check -s exit:0 -o inline:"=\n" -e not-match:"usage: mport" \
		"${MPORT_BIN}" -U version -t 1 1
	atf_check -s exit:0 -o inline:"=\n" -e not-match:"usage: mport" \
		"${MPORT_BIN}" -q -U version -t 2.0 2.0
	# and the same without a global option still works
	atf_check -s exit:0 -o inline:"=\n" "${MPORT_BIN}" version -t 1 1
}

atf_test_case global_option_before_info
global_option_before_info_head()
{
	atf_set "descr" "mport -U info <pkg> runs instead of printing usage (registry required)"
}
global_option_before_info_body()
{
	if [ ! -f /var/db/mport/master.db ]; then
		atf_skip "no local package registry at /var/db/mport/master.db"
	fi

	# whatever info says about an unknown package, it must not be the
	# usage text that a lost package argument produces
	atf_check -s ignore -o not-match:"usage: mport" -e not-match:"usage: mport" \
		"${MPORT_BIN}" -U info no-such-package-zzz
}

atf_test_case smoke_vector_paths
smoke_vector_paths_head()
{
	atf_set "descr" "config get and search run cleanly (registry required)"
}
smoke_vector_paths_body()
{
	if [ ! -f /var/db/mport/master.db ]; then
		atf_skip "no local package registry at /var/db/mport/master.db"
	fi

	# configGet(): exercises freeing the strdup'd setting value.
	atf_check -s exit:0 -o ignore -e not-match:"AddressSanitizer" \
		"${MPORT_BIN}" config get mirror_region

	# search(): exercises iterating and freeing an index-entry vector, the
	# same advanced-pointer-free pattern as audit()/deleteAll() but fast.
	# Result count and exit vary with the local index, so status/output are
	# ignored; what matters is AddressSanitizer reporting no memory error.
	atf_check -s ignore -o ignore -e not-match:"AddressSanitizer" \
		"${MPORT_BIN}" -U search mport
}

atf_test_case config_abi_derived
config_abi_derived_head()
{
	atf_set "descr" "config get ABI/ALTABI print bare pkg-style values and cannot be set (registry required)"
}
config_abi_derived_body()
{
	if [ ! -f /var/db/mport/master.db ]; then
		atf_skip "no local package registry at /var/db/mport/master.db"
	fi

	atf_check -s exit:0 -o match:'^MidnightBSD:[0-9]+\.[0-9]+:(amd64|i386)$' \
		"${MPORT_BIN}" config get ABI
	atf_check -s exit:0 -o match:'^midnightbsd:[0-9]+\.[0-9]+:x86:(64|32)$' \
		"${MPORT_BIN}" config get ALTABI
	atf_check -s exit:0 -o match:'^ABI=MidnightBSD:' -o match:'^ALTABI=midnightbsd:' \
		"${MPORT_BIN}" config list
	atf_check -s exit:1 -o empty -e match:'ABI is derived' \
		"${MPORT_BIN}" config set ABI MidnightBSD:9.9:amd64
	atf_check -s exit:1 -o empty -e match:'ALTABI is derived' \
		"${MPORT_BIN}" config set ALTABI midnightbsd:9.9:x86:64

	# an unreadable ABI_FILE is reported by name; list still succeeds
	atf_check -s exit:1 -o empty -e match:'ABI_FILE /nonexistent' \
		env ABI_FILE=/nonexistent "${MPORT_BIN}" config get ABI
	atf_check -s exit:0 -o not-match:'^ABI=' -e match:'ABI: .*ABI_FILE /nonexistent' \
		env ABI_FILE=/nonexistent "${MPORT_BIN}" config list
}

atf_test_case verify_skips_untrusted_chroot_mtree
verify_skips_untrusted_chroot_mtree_head()
{
	atf_set "descr" "mport -c <dir> verify does not execute an mtree binary the chroot owner supplied"
	atf_set "require.user" "root"
	atf_set "require.progs" "sqlite3"
}
verify_skips_untrusted_chroot_mtree_body()
{
	setup_gperf_chroot

	# a fake mtree in the target root that records if it ever runs
	mkdir -p root/bin root/usr/sbin root/tmp
	cp /rescue/sh root/bin/sh
	printf '#!/bin/sh\n: >/tmp/mtree-ran\nexit 0\n' >root/usr/sbin/mtree
	chmod 755 root/usr/sbin/mtree

	# not root-owned: must be skipped, never executed
	chown nobody root/usr/sbin/mtree
	atf_check -s exit:0 -o save:out -e save:err \
		"${MPORT_BIN}" -c "${PWD}/root" verify
	atf_check -s exit:0 -o ignore grep -q "mtree gperf-3.1: skipped" out err
	atf_check -s exit:1 test -e root/tmp/mtree-ran

	# control: a root-owned helper is trusted and runs
	chown root root/usr/sbin/mtree
	atf_check -s exit:0 -o ignore -e ignore \
		"${MPORT_BIN}" -c "${PWD}/root" verify
	atf_check -s exit:0 test -e root/tmp/mtree-ran
}

# a chroot under root/ registering one package, gperf, with an mtree spec
setup_gperf_chroot()
{
	mkdir -p root/var/db/mport/infrastructure/gperf-3.1 root/usr/local/share/licenses/gperf-3.1
	printf '/set type=dir\n.\n    share\n    ..\n..\n' >root/var/db/mport/infrastructure/gperf-3.1/mtree

	sqlite3 root/var/db/mport/master.db \
		"CREATE TABLE packages (pkg text NOT NULL, version text NOT NULL, origin text NOT NULL, prefix text NOT NULL, lang text, options text, status text default 'dirty', comment text, os_release text NOT NULL default '1.0', cpe text, locked int NOT NULL default '0', deprecated text default '', expiration_date int64 NOT NULL default '0', no_provide_shlib int default '0', flavor text default '', automatic int default '0', install_date int64 NOT NULL default '0', type int NOT NULL default '0', flatsize int64 NOT NULL default '0');" \
		"CREATE UNIQUE INDEX packages_pkg ON packages (pkg);" \
		"CREATE TABLE depends (pkg text NOT NULL, depend_pkgname text NOT NULL, depend_pkgversion text, depend_port text NOT NULL);" \
		"CREATE TABLE log (pkg text NOT NULL, version text NOT NULL, date int NOT NULL, msg text NOT NULL);" \
		"CREATE TABLE assets (pkg text NOT NULL, type int NOT NULL, data text, checksum text, owner text, grp text, mode text);" \
		"CREATE TABLE categories (pkg text NOT NULL, category text NOT NULL);" \
		"CREATE TABLE conflicts (pkg text NOT NULL, conflict_pkg text NOT NULL, conflict_version text NOT NULL);" \
		"CREATE TABLE annotation (pkg text NOT NULL, tag TEXT NOT NULL, val TEXT NOT NULL, PRIMARY KEY (pkg, tag));" \
		"INSERT INTO packages (pkg, version, origin, prefix, lang, options, status, comment, os_release, cpe, locked, deprecated, expiration_date, no_provide_shlib, flavor, automatic, install_date, type, flatsize) VALUES ('gperf', '3.1', 'devel/gperf', '/usr/local', '', '', 'clean', '', '3.2', '', 0, '', 0, 0, '', 0, 0, 0, 682000);" \
		"INSERT INTO assets (pkg, type, data, checksum, owner, grp, mode) VALUES ('gperf', 24, '/usr/local/share/licenses/gperf-3.1', NULL, NULL, NULL, NULL);"
}

atf_init_test_cases()
{
	srcdir=$(atf_get_srcdir)
	: "${LD_LIBRARY_PATH:=${srcdir}/../libmport}"
	export LD_LIBRARY_PATH
	# LeakSanitizer is unsupported on MidnightBSD; keep ASan to memory errors.
	: "${ASAN_OPTIONS:=detect_leaks=0}"
	export ASAN_OPTIONS

	: "${MPORT_BIN:=${srcdir}/../mport/mport}"
	export MPORT_BIN

	atf_add_test_case usage_without_command
	atf_add_test_case help_flag_prints_usage
	atf_add_test_case rejects_invalid_global_flag
	atf_add_test_case reports_bad_chroot
	atf_add_test_case global_option_before_subcommand
	atf_add_test_case global_option_before_info
	atf_add_test_case smoke_vector_paths
	atf_add_test_case config_abi_derived
	atf_add_test_case verify_skips_untrusted_chroot_mtree
}
